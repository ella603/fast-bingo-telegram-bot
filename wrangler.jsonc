{

  "name": "fast-bingo-mini-app",

  "main": "worker.js",

  "compatibility_date": "2026-09-22",

  "durable_objects": {

    "bindings": [

      {

        "name": "GAME_SCHEDULER",

        "class_name": "GameScheduler"

      }

    ]

  },

  "exports": {

    "GameScheduler": {

      "type": "durable-object",

      "storage": "sqlite"

    }

  },

  "observability": {

    "logs": {

      "enabled": true,

      "head_sampling_rate": 1,

      "invocation_logs": true,

      "persist": true

    },

    "traces": {

      "enabled": false,

      "head_sampling_rate": 1,

      "persist": true

    }

  }

}
