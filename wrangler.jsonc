{

  "name": "fast-bingo-mini-app",

  "main": "worker.js",

  "compatibility_date": "2026-09-22",

  "durable_objects": {

    "bindings": [

      {

        "name": "GAME_SCHEDULER",

        "class_name": "GameScheduler"

      }

    ]

  },

  "exports": {

    "GameScheduler": {

      "type": "durable-object",

      "storage": "sqlite"

    }

  }

}
